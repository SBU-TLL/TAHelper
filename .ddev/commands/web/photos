#!/bin/bash
## Description: Extract student photos from saved SOLAR pages (or --verify a roster)
## Usage: photos [--course C] [--in DIR] [--out DIR] [--verify ROSTER] [--images DIR]
## Example: "ddev photos --course BIO354"          (does this course have its photos?)
## Example: "ddev photos --in ./solar-pages --out data/BIO354/images"
## ProjectTypes: php
cd /var/www/html || exit 1

# DDEV does not preserve quoting when it forwards arguments to a custom command:
#   ddev photos --in "./Bio 354 Fall 2026"
# arrives here as five separate arguments (--in, ./Bio, 354, Fall, 2026).
# Reassemble anything between one --flag and the next into a single value, so
# paths containing spaces survive.
args=()
current=""
have_current=0

flush() {
    if [ "$have_current" = 1 ]; then
        args+=("$current")
        have_current=0
        current=""
    fi
}

for token in "$@"; do
    case "$token" in
        --*)
            flush
            args+=("$token")
            ;;
        *)
            if [ "$have_current" = 1 ]; then
                current="$current $token"
            else
                current="$token"
                have_current=1
            fi
            ;;
    esac
done
flush

# --course C is shorthand for "check the photos course C actually has":
#   --verify data/C/json/data.json --images data/C/images
# Without it, --verify compares the roster against what the saved SOLAR pages
# would produce, which is a different question and ignores what is installed.
final=()
i=0
while [ $i -lt ${#args[@]} ]; do
    if [ "${args[$i]}" = "--course" ]; then
        C="${args[$((i+1))]}"
        if [ -z "$C" ] || [ ! -d "/var/www/html/data/$C" ]; then
            echo "no such course: ${C:-<missing>}"
            echo "installed courses:"
            for d in /var/www/html/www/*/; do
                [ -f "$d/index.php" ] && basename "$d" | sed 's/^/  /'
            done
            exit 1
        fi
        final+=(--verify "data/$C/json/data.json" --images "data/$C/images")
        i=$((i+2))
    else
        final+=("${args[$i]}")
        i=$((i+1))
    fi
done

python3 extractStudentsFromHTML.py "${final[@]}"

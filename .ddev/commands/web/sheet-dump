#!/bin/bash
## Description: Download the course Google Sheet to CSV so you can inspect it
## Usage: sheet-dump <COURSE> [--list] [--out DIR] [--tab NAME] [--photos DIR]
## Example: "ddev sheet-dump BIO354 --list" | "ddev sheet-dump BIO354 --photos ./solar-pages/out"
## ProjectTypes: php
if [ -z "${1:-}" ]; then echo "usage: ddev sheet-dump <COURSE>   e.g. BIO354"; exit 1; fi
cd /var/www/html || exit 1

# DDEV does not preserve quoting when forwarding arguments to a custom command,
# so a path with spaces arrives as several arguments. Reassemble anything
# between one --flag and the next into a single value (same fix as `ddev photos`).
args=()
current=""
have_current=0

flush() {
    if [ "$have_current" = 1 ]; then
        args+=("$current")
        have_current=0
        current=""
    fi
}

for token in "$@"; do
    case "$token" in
        --*)
            flush
            args+=("$token")
            ;;
        *)
            if [ "$have_current" = 1 ]; then
                current="$current $token"
            else
                current="$token"
                have_current=1
            fi
            ;;
    esac
done
flush

python3 dumpSheet.py "${args[@]}"

#!/bin/bash
## Description: Regenerate a course's SYNTHETIC roster + placeholder photos
## Usage: roster <COURSE> [flags]
## Example: "ddev roster BIO201" | "ddev roster BIO354 --students 60 --sections 3"
## ProjectTypes: php
if [ -z "${1:-}" ]; then
    echo "usage: ddev roster <COURSE> [flags]      e.g. ddev roster BIO201"
    echo "installed courses:"
    for d in /var/www/html/www/*/; do
        [ -f "$d/index.php" ] && basename "$d" | sed 's/^/  /'
    done
    exit 1
fi
COURSE="$1"; shift
DATA="/var/www/html/data/$COURSE"
if [ ! -d "$DATA" ]; then echo "no such course: $COURSE"; exit 1; fi
cd /var/www/html || exit 1

python3 makeSyntheticRoster.py --force \
  --out-dir "$DATA/json" --image-dir "$DATA/images" "$@"

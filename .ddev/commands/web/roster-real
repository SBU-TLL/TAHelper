#!/bin/bash
## Description: Import a course's REAL roster from Google Sheets (needs client_secret.json)
## Usage: roster-real <COURSE>
## Example: "ddev roster-real BIO354"
## ProjectTypes: php
if [ -z "${1:-}" ]; then
    echo "usage: ddev roster-real <COURSE>       e.g. ddev roster-real BIO354"
    echo "installed courses:"
    for d in /var/www/html/www/*/; do
        [ -f "$d/index.php" ] && [ -L "$d/json" ] && basename "$d" | sed 's/^/  /'
    done
    exit 1
fi
COURSE="$1"
DATA="/var/www/userData/TAHelper/$COURSE"
if [ ! -d "$DATA" ]; then echo "no such course: $COURSE"; exit 1; fi
cd /var/www/html || exit 1

echo "Importing the REAL roster for $COURSE into $DATA/json (real student data)."
echo "This WRITES FILES; the output below is only a log — do not redirect it to"
echo "a .json file. Run 'ddev roster $COURSE' to go back to the synthetic roster."
echo

TAHELPER_JSON_DIR="$DATA/json" python3 makeJSON.py "$COURSE" || exit 1

echo
python3 - "$DATA/json/data.json" "$COURSE" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
print(f"{sys.argv[2]}: {len(d['Student Groups'])} students, {len(d['TA Groups'])} staff "
      f"(stored outside the repo; nothing to commit).")
PY

###############################################################################
# TAHelper — production environment template
#
# Copy to your runtime secret store / Azure container env (do NOT commit a real
# .env). Values here are PLACEHOLDERS. TAHelper has NO database and NO API
# secrets. This template documents the platform/auth contract.
#
# NOTE: TAHelper's per-environment configuration is FILE-based (iam.php,
# json/dataDev.json, .htaccess, images/), NOT env vars — those files are
# gitignored and EXCLUDED from the image; production must provide them at
# runtime (mount or Ansible-provision). See "Provisioned files" below.
###############################################################################

# --- Environment flag --------------------------------------------------------
APP_ENV=production
TZ=America/New_York

# --- Ingress / routing -------------------------------------------------------
PUBLIC_HOSTNAME=tahelper.<your-subdomain>.stonybrook.edu
# Apache listens on 8080 inside the container (non-root); ingress forwards
# 443 -> 8080. "/" serves the SPA (index.html).
APACHE_LISTEN_PORT=8080

# --- Provisioned files (MOUNT / provision at deploy — NOT in the image) -------
# The SPA fetches ./iam.php for identity and reads json/dataDev.json for the
# roster; the endpoints are gated ONLY by the Shibboleth .htaccess. Provide:
#   /var/www/html/iam.php            REAL Shibboleth iam.php (reads $_SERVER
#                                    cn/nickname/sn) — NOT the cn=testta mock
#   /var/www/html/json/dataDev.json  this environment's TA/Student group roster
#   /var/www/html/.htaccess          the Shibboleth gate (AuthType shibboleth,
#                                    require ... ) — enforced by mod_shib
#   /var/www/html/images/            student photos (PII), if used
# e.g.:
#   docker run \
#     -v /run/secrets/tahelper-iam.php:/var/www/html/iam.php:ro \
#     -v /etc/tahelper/dataDev.json:/var/www/html/json/dataDev.json:ro \
#     -v /etc/tahelper/shib.htaccess:/var/www/html/.htaccess:ro \
#     -v tahelper-images:/var/www/html/images ...

# --- Authentication ----------------------------------------------------------
# Shibboleth, enforced at the ingress / reverse proxy (Ansible-managed) AND by
# the provisioned .htaccess. -> The deploy MUST assert mod_shib is loaded.
# WARNING: the PHP endpoints do NO server-side authorization — they trust the
# $_GET/$_POST params, so the Shibboleth gate is the ONLY access control. A
# logged-in TA can read/write other groups' data by crafting params, and
# responseInfo.php's "clear" builds glob+unlink from POST input. Add server-side
# authz + input validation before Azure. (Flagged; not changed.)

# --- Storage -----------------------------------------------------------------
# Per-eval responses are JSON files under studentResponses/ and groupResponses/
# (writable). Mount volumes there so responses survive redeploys:
#   docker run -v tahelper-student:/var/www/html/studentResponses \
#              -v tahelper-group:/var/www/html/groupResponses ...
# No SQL database; no secrets beyond the provisioned files above.

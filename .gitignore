# ignore hidden files
.DS_Store
.htaccess
._*
.vscode
# ignore secret files
# Per-developer IdP logins written by `ddev add-test-ta` (see the .example).
# These are local test identities, not project configuration.
/.ddev/shib-idp/config/users-app.php
/.ddev/shib-idp/config/users-app.local.json
/www/iam.php
/www/json/dataDev.json
# ignore directories
*Responses/
images/

client_secret.json
# editor swap files
*.swp
*.swo
__pycache__/

# --- course data: NEVER commit ----------------------------------------------
# Rosters, student photos and saved evaluations for every course. This lives
# inside the repo, so git has to be told about all of it: everything under
# data/ is ignored except the note explaining what belongs there.
/data/*
!/data/README.md

# --- generated roster data: NEVER commit ------------------------------------
# Produced by makeJSON.py from the live Google Sheet and containing real
# student names/netIDs. Local development uses makeSyntheticRoster.py instead;
# .ddev provisions a synthetic data.json automatically on `ddev start`.
# (roster data now lives outside the repo entirely, under
# ../userData/TAHelper/<COURSE>/json — reachable only through the per-course
# symlinks, so there is nothing left inside the repo to ignore.)
# Saved SOLAR exports arrive as whole folders with arbitrary names; ignore the
# folder as well as the pages and photos inside it.
/Bio */
/solar-pages/
# Saved SOLAR pages and extracted photos (real student names + faces).
# These arrive as arbitrary folder names, so match them anywhere in the tree.
Temp/
out/
*_files/
*.html
!www/**/*.html
no-image.png
# Raw CSV dumps of the course spreadsheet (dumpSheet.py) — whole roster in clear.
sheet-dump/
# Student photos are named "{Name},{sha256}.jpg" — catch them wherever they land
*,????????????????????????????????????????????????????????????????.jpg
*,????????????????????????????????????????????????????????????????.JPG


data/
userData/
data-imports/